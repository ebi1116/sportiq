# Paste your Google OAuth values below (no quotes, no spaces around =)
GOOGLE_CLIENT_ID=paste-your-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=paste-your-client-secret-here

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=1
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=

# Optional PostgreSQL (leave commented to use SQLite)
# DB_NAME=sportiq
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
